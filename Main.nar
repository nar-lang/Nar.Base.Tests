    , Nar.Base.Tests.Math.tests
    , Nar.Base.Tests.Maybe.tests
    , Nar.Base.Tests.Result.tests
    , Nar.Base.Tests.Set.tests
    , Nar.Base.Tests.String.tests
    , Nar.Base.Tests.Tuple.tests
    ]
